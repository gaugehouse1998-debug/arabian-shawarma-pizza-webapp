{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Food menu item listing with individual photographs, prices, and sizes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "basePrice": { "type": "number" },
        "image": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" }
      },
      "required": ["id", "name", "category", "basePrice", "image", "isAvailable"]
    },
    "Category": {
      "title": "Category",
      "description": "Food menu category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" }
      },
      "required": ["id", "name", "order", "isActive"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Combo meal deal offer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dealNumber": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 600 },
        "category": { "type": "string", "maxLength": 80 },
        "items": { "type": "array" },
        "includedItems": { "type": "array" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountLabel": { "type": "string", "maxLength": 80 },
        "displayOrder": { "type": "number" },
        "image": { "type": "string", "maxLength": 2000 },
        "badge": { "type": "string", "maxLength": 60 },
        "isActive": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string", "maxLength": 64 },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "deletedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "dealNumber", "title", "price", "image", "isActive"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional coupon code with validity dates, usage caps, and category/product restrictions.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 64, "pattern": "^[A-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 500 },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 64 },
        "expiryDate": { "type": "string", "maxLength": 64 },
        "usageLimit": { "type": "number" },
        "perCustomerLimit": { "type": "number" },
        "applicableCategories": { "type": "array" },
        "applicableProductIds": { "type": "array" },
        "timesUsed": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "deletedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["code", "discountType", "discountValue", "minOrderValue", "timesUsed", "isActive"]
    },
    "CouponRedemption": {
      "title": "CouponRedemption",
      "description": "Audit record of a completed coupon redemption linked to a confirmed order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "couponCode": { "type": "string", "maxLength": 64 },
        "orderId": { "type": "string", "maxLength": 64 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 160 },
        "discountAmount": { "type": "number" },
        "orderSubtotal": { "type": "number" },
        "redeemedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "couponCode", "orderId", "customerPhone", "discountAmount", "orderSubtotal", "redeemedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer feedback linked optionally to an order and moderated by admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 64 },
        "customerName": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1200 },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "hidden"] },
        "isApproved": { "type": "boolean" },
        "itemOrdered": { "type": "string", "maxLength": 200 },
        "moderatedAt": { "type": "string", "maxLength": 64 },
        "moderatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "customerName", "rating", "comment", "date", "isApproved"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer food order with immutable item snapshots.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "createdAt", "status", "total"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional homepage banner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string" },
        "deletedBy": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl", "isActive"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative security and action audit trail record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "entityType", "performedBy", "timestamp"]
    },
    "DeliveryZone": {
      "title": "DeliveryZone",
      "description": "Admin-managed delivery area with fees, delivery time estimates, and optional coordinates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "city": { "type": "string", "maxLength": 80 },
        "fee": { "type": "number" },
        "estimatedMinutes": { "type": "string", "maxLength": 60 },
        "minOrder": { "type": "number" },
        "instructions": { "type": "string", "maxLength": 400 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusKm": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "deletedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "fee", "estimatedMinutes", "minOrder", "isActive"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "Restaurant operational settings including coordinates and 10 KM delivery radius.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 140 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 80 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "deliveryRadiusKm": { "type": "number" },
        "defaultDeliveryFee": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "minimumOrderAmount": { "type": "number" },
        "deliveryAvailable": { "type": "boolean" },
        "pickupAvailable": { "type": "boolean" }
      },
      "required": ["name", "address", "city", "latitude", "longitude", "deliveryRadiusKm"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Food menu items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories"
    },
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Combos and deals"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Promotional banners"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Security audit logs"
    },
    "/deliveryZones/{zoneId}": {
      "schema": "DeliveryZone",
      "description": "Admin-managed delivery coverage areas"
    },
    "/restaurantSettings/{settingId}": {
      "schema": "RestaurantSettings",
      "description": "Restaurant coordinates, delivery radius, and store preferences"
    },
    "/coupons/{couponCode}": {
      "schema": "Coupon",
      "description": "Promotional discount coupons"
    },
    "/couponRedemptions/{redemptionId}": {
      "schema": "CouponRedemption",
      "description": "Completed order coupon redemptions"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and moderation statuses"
    }
  }
}
